<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.order.mapper.GoodsMapper">

    <update id="update" parameterType="org.example.goods.POJO.Goods">
        UPDATE goods
        <set>
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="goodsDesc != null">goods_desc = #{goodsDesc},</if>
            <if test="goodsPic != null">goods_pic = #{goodsPic},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="sellPrice != null">sell_price = #{sellPrice},</if>
            <if test="sellerId != null">seller_id = #{sellerId},</if>
            <if test="goodsStatus != null">goods_status = #{goodsStatus},</if>
            <if test="isNew != null">is_new = #{isNew},</if>
            <if test="stock != null">stock = #{stock},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <select id="findAllOnSale" resultType="org.example.goods.POJO.Goods">
        SELECT * FROM goods WHERE goods_status = 1
    </select>
</mapper>
